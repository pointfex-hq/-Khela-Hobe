# Khela Hobe Backend Environment Template
# Copy needed keys to backend/.env (never commit real secrets)

DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

PORT=8080
NODE_ENV=development
JWT_SECRET="replace-with-strong-random-secret"
SESSION_SECRET="replace-with-strong-random-session-secret"

FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:8080"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8080/api/v1"
CORS_ORIGIN="http://localhost:5173"

# Optional Redis (Upstash rediss://... or local redis://localhost:6379)
# Leave blank to use built-in in-memory cache fallback
REDIS_URL=""

# Email Delivery — Option 1: Brevo (HTTP API or SMTP Relay)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@khelahobe.com"
BREVO_SENDER_NAME="Khela Hobe"
BREVO_SMTP_USER=""
BREVO_SMTP_KEY=""

# Email Delivery — Option 2: Resend
RESEND_API_KEY=""
EMAIL_FROM="Khela Hobe <onboarding@resend.dev>"

# Email Delivery — Option 3: Gmail SMTP (App Password)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Email Delivery — Option 4: Custom SMTP
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8080/api/v1/auth/google/callback"

# S3 / Supabase Storage
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="true"
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_S3_PUBLIC_URL=""

# SSLCommerz Sandbox / Live
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_SANDBOX="true"
